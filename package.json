{
  "name": "sovran",
  "displayName": "Sovran",
  "description": "Own your intelligence. An agentic AI coding assistant for the models you run: local, self-hosted or behind your company gateway. No backend, no telemetry.",
  "version": "0.1.0",
  "publisher": "minells",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Minells/sovran#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minells/sovran.git"
  },
  "bugs": {
    "url": "https://github.com/Minells/sovran/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agent",
    "llm",
    "local llm",
    "self-hosted",
    "private ai",
    "ollama",
    "lm studio",
    "vllm",
    "litellm",
    "openai-compatible",
    "coding assistant",
    "enterprise"
  ],
  "icon": "media/brand/icon.png",
  "galleryBanner": {
    "color": "#0F1012",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:sovran.chatPanel"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode SOVRAN only runs in Plan mode: it can read and explain code but cannot edit files or run commands.",
      "restrictedConfigurations": [
        "sovran.context.projectInstructions"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "SOVRAN needs a local or remote file system to run tools and terminal commands."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sovran",
          "title": "Sovran",
          "icon": "media/brand/sovran-activitybar.svg"
        }
      ]
    },
    "icons": {
      "sovran-logo": {
        "description": "Sovran logo",
        "default": {
          "fontPath": "media/brand/sovran-icons.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "views": {
      "sovran": [
        {
          "type": "webview",
          "id": "sovran.chat",
          "name": "Sovran",
          "icon": "media/brand/sovran-activitybar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "sovran.newSession",
        "title": "New Chat",
        "category": "Sovran",
        "icon": "$(add)"
      },
      {
        "command": "sovran.newChatInEditor",
        "title": "New Chat in Editor",
        "category": "Sovran",
        "icon": "$(add)"
      },
      {
        "command": "sovran.openInEditor",
        "title": "Open Chat in Editor",
        "category": "Sovran",
        "icon": "$(link-external)"
      },
      {
        "command": "sovran.acceptProposal",
        "title": "Apply Proposed Change",
        "category": "Sovran",
        "icon": "$(check)",
        "enablement": "sovran.approvalPending"
      },
      {
        "command": "sovran.rejectProposal",
        "title": "Reject Proposed Change",
        "category": "Sovran",
        "icon": "$(close)",
        "enablement": "sovran.approvalPending"
      },
      {
        "command": "sovran.showHistory",
        "title": "Chat History",
        "category": "Sovran",
        "icon": "$(history)"
      },
      {
        "command": "sovran.openSettings",
        "title": "Settings",
        "category": "Sovran",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sovran.manageProviders",
        "title": "Manage Model Providers",
        "category": "Sovran",
        "icon": "$(server-environment)"
      },
      {
        "command": "sovran.openConfigFile",
        "title": "Open Model Config File (config.yaml)",
        "category": "Sovran",
        "icon": "$(file-code)"
      },
      {
        "command": "sovran.selectModel",
        "title": "Select Model\u2026",
        "category": "Sovran"
      },
      {
        "command": "sovran.setApiKey",
        "title": "Set Provider API Key\u2026",
        "category": "Sovran"
      },
      {
        "command": "sovran.toggleMode",
        "title": "Toggle Plan / Act Mode",
        "category": "Sovran"
      },
      {
        "command": "sovran.setApprovalMode",
        "title": "Change Approval Mode\u2026",
        "category": "Sovran"
      },
      {
        "command": "sovran.focus",
        "title": "Focus Panel",
        "category": "Sovran"
      },
      {
        "command": "sovran.askAboutSelection",
        "title": "Ask Sovran About Selection",
        "category": "Sovran"
      },
      {
        "command": "sovran.attachFiles",
        "title": "Add Files to Context\u2026",
        "category": "Sovran"
      },
      {
        "command": "sovran.cancelRun",
        "title": "Stop Agent",
        "category": "Sovran"
      },
      {
        "command": "sovran.showLogs",
        "title": "Show Logs",
        "category": "Sovran"
      },
      {
        "command": "sovran.compact",
        "title": "Compact Conversation",
        "category": "Sovran"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sovran.newSession",
          "when": "view == sovran.chat",
          "group": "navigation@1"
        },
        {
          "command": "sovran.openInEditor",
          "when": "view == sovran.chat",
          "group": "navigation@2"
        },
        {
          "command": "sovran.showHistory",
          "when": "view == sovran.chat",
          "group": "navigation@3"
        },
        {
          "command": "sovran.openSettings",
          "when": "view == sovran.chat",
          "group": "navigation@4"
        },
        {
          "command": "sovran.newChatInEditor",
          "when": "view == sovran.chat",
          "group": "0_chat@1"
        },
        {
          "command": "sovran.manageProviders",
          "when": "view == sovran.chat",
          "group": "1_configure@1"
        },
        {
          "command": "sovran.openConfigFile",
          "when": "view == sovran.chat",
          "group": "1_configure@2"
        },
        {
          "command": "sovran.setApprovalMode",
          "when": "view == sovran.chat",
          "group": "1_configure@3"
        },
        {
          "command": "sovran.showLogs",
          "when": "view == sovran.chat",
          "group": "2_help@1"
        }
      ],
      "editor/title": [
        {
          "command": "sovran.rejectProposal",
          "when": "resourceScheme == sovran-proposal && sovran.approvalPending",
          "group": "navigation@1"
        },
        {
          "command": "sovran.acceptProposal",
          "when": "resourceScheme == sovran-proposal && sovran.approvalPending",
          "group": "navigation@2"
        },
        {
          "command": "sovran.newChatInEditor",
          "when": "activeWebviewPanelId == 'sovran.chatPanel'",
          "group": "navigation@1"
        },
        {
          "command": "sovran.showHistory",
          "when": "activeWebviewPanelId == 'sovran.chatPanel'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sovran.acceptProposal",
          "when": "sovran.approvalPending"
        },
        {
          "command": "sovran.rejectProposal",
          "when": "sovran.approvalPending"
        }
      ],
      "editor/context": [
        {
          "command": "sovran.askAboutSelection",
          "when": "editorHasSelection",
          "group": "sovran@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sovran.focus",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y"
      },
      {
        "command": "sovran.askAboutSelection",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "sovran.acceptProposal",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "resourceScheme == sovran-proposal && sovran.approvalPending"
      }
    ],
    "configuration": [
      {
        "id": "sovran-models",
        "title": "Models",
        "order": 1,
        "properties": {
          "sovran.providers": {
            "type": "array",
            "scope": "application",
            "default": [],
            "markdownDescription": "Model providers (OpenAI-compatible endpoints). API keys are **not** stored here; use `SOVRAN: Set Provider API Key\u2026`. Only user settings are honored, workspace settings are ignored for security.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "baseUrl"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$",
                  "description": "Stable identifier (lowercase letters, digits, - and _)."
                },
                "name": {
                  "type": "string",
                  "description": "Display name."
                },
                "baseUrl": {
                  "type": "string",
                  "description": "Base URL including the API version path, e.g. http://localhost:11434/v1"
                },
                "auth": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "none",
                        "bearer",
                        "header"
                      ],
                      "default": "bearer"
                    },
                    "headerName": {
                      "type": "string",
                      "description": "Header name used when type is 'header' (e.g. api-key)."
                    }
                  }
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Additional non-secret headers sent with every request."
                },
                "timeoutSeconds": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 1800,
                  "default": 120
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "contextWindow": {
                        "type": "number",
                        "minimum": 1024
                      },
                      "maxOutputTokens": {
                        "type": "number",
                        "minimum": 64
                      },
                      "temperature": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2
                      },
                      "toolMode": {
                        "type": "string",
                        "enum": [
                          "auto",
                          "native",
                          "prompted",
                          "none"
                        ],
                        "default": "auto"
                      },
                      "vision": {
                        "type": "boolean",
                        "markdownDescription": "Whether the model accepts images. `true` always sends attached images, `false` sends only their names. Leave it unset and Sovran sends them, and stops if the server refuses."
                      }
                    }
                  }
                }
              }
            },
            "order": 1
          },
          "sovran.configFile.enabled": {
            "type": "boolean",
            "scope": "application",
            "default": true,
            "markdownDescription": "Use `~/.sovran/config.yaml` when it exists and keep it in sync with `#sovran.providers#`: saving the file updates Settings, changing providers in Settings updates the file (comments are kept). Off: the file is ignored and Settings are used alone.",
            "order": 4
          },
          "sovran.defaultModel": {
            "type": "string",
            "scope": "application",
            "default": "",
            "description": "Model used for new chats, as providerId/modelId.",
            "order": 2
          },
          "sovran.planModel": {
            "type": "string",
            "scope": "application",
            "default": "",
            "description": "Model used in Plan mode, as providerId/modelId. Empty means the same model as Act mode.",
            "order": 3
          }
        }
      },
      {
        "id": "sovran-approvals",
        "title": "Approvals & Safety",
        "order": 2,
        "properties": {
          "sovran.approvals.mode": {
            "type": "string",
            "scope": "application",
            "enum": [
              "ask",
              "edits",
              "auto"
            ],
            "enumItemLabels": [
              "Ask",
              "Auto-edit",
              "Auto"
            ],
            "default": "ask",
            "markdownEnumDescriptions": [
              "Review every file change in a diff and approve every command.",
              "Apply file changes without asking. Commands still ask unless they are in `#sovran.approvals.allowedCommands#`.",
              "Edit files and run commands without asking. Protected files, risky commands (delete, push, publish, `sudo`, network, paths outside the workspace) and hidden characters still ask. **Use only in repositories you trust.**"
            ],
            "markdownDescription": "Approval mode Act mode starts in when a window opens. Change it for the current window from the composer, from Sovran Settings or with `Sovran: Change Approval Mode\u2026`. Plan mode is always read-only.",
            "order": 1
          },
          "sovran.approvals.allowedCommands": {
            "type": "array",
            "scope": "application",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Commands that run without approval when the requested command equals an entry or starts with it followed by a space (e.g. `npm test`). Commands containing shell operators (`; & | $ > <` \u2026) and risky commands (delete, push, publish, `sudo`, network, paths outside the workspace) always ask. Add entries from an approval card with **Always allow**.",
            "order": 2
          },
          "sovran.security.protectedPaths": {
            "type": "array",
            "scope": "application",
            "items": {
              "type": "string"
            },
            "default": [
              "**/.env",
              "**/.env.*",
              "**/*.pem",
              "**/*.key",
              "**/id_rsa*",
              "**/id_ed25519*",
              "**/.git/**",
              "**/.npmrc",
              "**/.pypirc",
              "**/.netrc"
            ],
            "description": "Glob patterns that always require approval to read or modify, in every approval mode. Their contents are excluded from search, and commands that name them ask too.",
            "order": 3
          },
          "sovran.approvals.fileEdits": {
            "type": "string",
            "scope": "application",
            "enum": [
              "ask",
              "auto"
            ],
            "default": "ask",
            "enumDescriptions": [
              "Review every file change in a diff before it is applied.",
              "Apply file changes without asking (protected paths still ask)."
            ],
            "description": "How file edits proposed in Act mode are approved.",
            "markdownDeprecationMessage": "Use `#sovran.approvals.mode#` instead. `auto` here is the same as `edits` there.",
            "order": 4
          }
        }
      },
      {
        "id": "sovran-tools",
        "title": "Tools",
        "order": 3,
        "properties": {
          "sovran.tools.disabled": {
            "type": "array",
            "scope": "application",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            },
            "uniqueItems": true,
            "default": [],
            "markdownDescription": "Native tools excluded from model requests and blocked at execution, including pending approvals. Use tool names such as `execute_terminal` or `write_file`. Only user settings are honored. MCP tools use their own Off / Ask / Allow controls."
          },
          "sovran.tools.forceAsk": {
            "type": "array",
            "scope": "application",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,64}$"
            },
            "uniqueItems": true,
            "default": [],
            "markdownDescription": "Native tools that always require approval, including read tools and tools in Auto mode. Plan mode and Restricted Mode restrictions still apply. Only user settings are honored."
          }
        }
      },
      {
        "id": "sovran-agent",
        "title": "Agent",
        "order": 3,
        "properties": {
          "sovran.agent.maxIterations": {
            "type": "number",
            "default": 25,
            "minimum": 1,
            "maximum": 200,
            "description": "Maximum model round-trips per request before the agent stops.",
            "order": 1
          },
          "sovran.terminal.timeoutSeconds": {
            "type": "number",
            "scope": "application",
            "default": 120,
            "minimum": 5,
            "maximum": 3600,
            "description": "Default timeout for agent terminal commands.",
            "order": 2
          },
          "sovran.terminal.mirrorToTerminal": {
            "type": "boolean",
            "default": true,
            "description": "Mirror agent command output to a Sovran terminal panel. User settings only.",
            "scope": "application",
            "order": 3
          },
          "sovran.diff.openOnProposal": {
            "type": "boolean",
            "default": true,
            "description": "Open the native diff editor automatically when the agent proposes a file change.",
            "order": 4
          }
        }
      },
      {
        "id": "sovran-mcp",
        "title": "Tools: Integrations",
        "order": 4,
        "properties": {
          "sovran.mcp.servers": {
            "type": "array",
            "scope": "application",
            "default": [],
            "markdownDescription": "MCP servers whose tools the agent can use in Act mode. Each tool asks before it runs, in every approval mode, until you allow it. Manage them in **Sovran Settings \u2192 Tools**. Tokens are **not** stored here: use *Set token*, which keeps them in Secret Storage. Only user settings are honored: a workspace can never start a server.",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
                  "description": "Stable identifier (lowercase letters, digits and -). Tool names are mcp__<id>__<tool>."
                },
                "name": {
                  "type": "string",
                  "description": "Display name."
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "command": {
                  "type": "string",
                  "description": "A local server: the program to start, for example npx or uvx. Set either command or url."
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "markdownDescription": "Arguments of `command`. `${workspaceFolder}`, `${userHome}` and `${env:NAME}` are expanded."
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Environment variables for a local server (not secrets: use auth with type env)."
                },
                "cwd": {
                  "type": "string",
                  "description": "Working folder of a local server. Default: the first workspace folder."
                },
                "url": {
                  "type": "string",
                  "description": "A remote server: its Streamable HTTP endpoint, for example https://mcp.example.com/mcp."
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Headers sent to a remote server (not secrets: use auth)."
                },
                "auth": {
                  "type": "object",
                  "markdownDescription": "Where the token from Secret Storage goes: `bearer` (Authorization header) or `header` for remote servers, `env` for local ones.",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "none",
                        "bearer",
                        "header",
                        "env"
                      ],
                      "default": "none"
                    },
                    "headerName": {
                      "type": "string",
                      "description": "Header that carries the token when type is header."
                    },
                    "envName": {
                      "type": "string",
                      "description": "Environment variable that carries the token when type is env."
                    }
                  }
                },
                "timeoutSeconds": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 3600,
                  "default": 60,
                  "description": "How long a request may go without an answer or progress."
                },
                "allowedTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tools that run without asking."
                },
                "disabledTools": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Tools never offered to the model."
                },
                "managed": {
                  "type": "object",
                  "description": "Catalog provenance. Managed launch uses the reviewed version and profile. Edit as a custom server to use custom launch settings.",
                  "required": [
                    "id",
                    "profile",
                    "version"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "enum": [
                        "playwright",
                        "devtools",
                        "github"
                      ]
                    },
                    "profile": {
                      "type": "string",
                      "enum": [
                        "isolated",
                        "extension",
                        "readonly",
                        "collaboration"
                      ]
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "browserProfile": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9 _-]{1,80}$"
                    }
                  }
                }
              }
            },
            "order": 1
          }
        }
      },
      {
        "id": "sovran-context",
        "title": "Context",
        "order": 5,
        "properties": {
          "sovran.context.includeActiveEditor": {
            "type": "boolean",
            "default": true,
            "description": "Attach the active file (or selection) to new messages by default.",
            "order": 1
          },
          "sovran.context.autoCompact": {
            "type": "boolean",
            "default": true,
            "description": "When the context window is full, summarize older messages instead of dropping them.",
            "order": 2
          },
          "sovran.context.projectInstructions": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Include `AGENTS.md` from the workspace root as project instructions (trusted workspaces only).",
            "order": 3
          },
          "sovran.context.maxToolResultChars": {
            "type": "number",
            "default": 20000,
            "minimum": 2000,
            "maximum": 200000,
            "description": "Maximum characters of a single tool result sent to the model.",
            "order": 4
          }
        }
      },
      {
        "id": "sovran-chats",
        "title": "Chats",
        "order": 6,
        "properties": {
          "sovran.sessions.persist": {
            "type": "boolean",
            "default": true,
            "description": "Save chats in VS Code workspace storage so they survive restarts.",
            "order": 1
          },
          "sovran.sessions.generateTitles": {
            "type": "boolean",
            "scope": "application",
            "default": true,
            "markdownDescription": "Name new chats with the model: Sovran sends the first message in one extra short request and uses the reply as the title (the first words are shown until it arrives). When off, the title is the first words of the first message. Uses `#sovran.sessions.titleModel#` when set.",
            "order": 2
          },
          "sovran.sessions.titleModel": {
            "type": "string",
            "scope": "application",
            "default": "",
            "markdownDescription": "Model that names chats, as providerId/modelId, for example a small fast model. Empty means the model of the chat. Applies only when `#sovran.sessions.generateTitles#` is on.",
            "order": 3
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "npm run build:host && npm run build:webview",
    "build:host": "node scripts/build-host.mjs --production",
    "build:webview": "vite build --config webview/vite.config.mts",
    "build:icons": "fantasticon --config .fantasticonrc.cjs",
    "watch:host": "node scripts/build-host.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch --mode development",
    "dev:webview": "vite --config webview/vite.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:extension": "node scripts/test-extension.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "verify:vsix": "node scripts/verify-vsix.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
